# /etc/default/quizthespire
# Environment variables for the quizthespire Go backend.
# Edit the DB credentials before first start.

# Server port (default: 8081)
PORT=8081

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=quiz_user
DB_PASSWORD=secure_password_not_here
DB_NAME=quizTheSpire

# Or use a full DSN instead:
# DATABASE_URL=quiz_user:password@tcp(127.0.0.1:3306)/quizTheSpire

# CORS allowed origins (comma-separated, empty = allow all)
CORS_ALLOWED_ORIGINS=https://quizthespire.com,https://www.quizthespire.com
CORS_ALLOW_CREDENTIALS=false