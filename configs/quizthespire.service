# configs/quizthespire.service
#
# systemd unit for the quizthespire.com Go backend.
# Confirmed against the live Pi 5 deployment, September 2026.
#
# Install:
#   sudo cp configs/quizthespire.service /etc/systemd/system/quizthespire.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now quizthespire
#   journalctl -u quizthespire -f
#
# Build (from the project directory):
#   GOOS=linux GOARCH=arm64 go build -o bin/quizthespire-server ./cmd/server
#
# Environment: copy configs/quizthespire.env to /etc/default/quizthespire
#   and edit the DB credentials before first start.

[Unit]
Description=quizthespire.com Go backend
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=student
Group=student
WorkingDirectory=/home/student/Project/project-one/backend-go
ExecStart=/home/student/Project/project-one/backend-go/bin/quizthespire-server
Restart=on-failure
RestartSec=5s

# Environment
Environment=PORT=8081
EnvironmentFile=-/etc/default/quizthespire

# Resource ceiling — tuned for Pi 5 (8GB RAM, 4 cores).
# Leaves headroom for Apache, MySQL, and the Python gamepad service.
MemoryMax=2G
CPUQuota=200%

# Sandboxing
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/student/Project/project-one/backend-go/logs /home/student/Project/project-one/data

# Logging via journald — view with: journalctl -u quizthespire -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=quizthespire

[Install]
WantedBy=multi-user.target
